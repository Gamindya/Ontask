<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_dialog"
    android:padding="25dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true" />

    <EditText
        android:id="@+id/editCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/txtTitle"
        android:layout_marginTop="25dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="Current Password"
        android:inputType="textPassword"
        android:textColorHint="#999999"
        android:textColor="@color/white"
        android:paddingStart="20dp" />

    <EditText
        android:id="@+id/editNewPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/editCurrentPassword"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="New Password"
        android:inputType="textPassword"
        android:textColorHint="#999999"
        android:textColor="@color/white"
        android:paddingStart="20dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnUpdatePassword"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_below="@id/editNewPassword"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:background="@drawable/bg_rounded_button"
        android:text="Update"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/txtCancelPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnUpdatePassword"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:text="Cancel"
        android:textColor="#999999"
        android:textSize="16sp"/>

</RelativeLayout>
