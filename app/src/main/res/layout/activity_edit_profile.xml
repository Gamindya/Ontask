<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="30dp">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit "
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="profile"
            android:textColor="@color/primary_blue"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgEditProfile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_rounded_input"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/btnChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Change Photo"
                android:textColor="@color/primary_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />

            <EditText
                android:id="@+id/editUpdateName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Update Name"
                android:textColorHint="#999999"
                android:textColor="@color/white"
                android:paddingStart="20dp"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/editUpdateEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Update E-mail"
                android:textColorHint="#999999"
                android:textColor="@color/white"
                android:paddingStart="20dp"
                android:layout_marginBottom="30dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenChangePassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_rounded_input"
                android:text="🔒 Change Password"
                android:textColor="#CCCCCC"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:layout_marginBottom="40dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveChanges"
                android:layout_width="160dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_rounded_button"
                android:text="Save changes"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/txtCancelEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="Cancel"
                android:textColor="#999999"
                android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
